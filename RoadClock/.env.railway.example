DEBUG=False
ALLOWED_HOSTS=your-railway-app.up.railway.app

# Railway Postgres can provide DATABASE_URL. This app prefers DATABASE_PUBLIC_URL
# so deploys do not depend on private Railway DNS.
# Replace "Postgres" below with your actual Railway Postgres service name.
# For Railway private networking, DATABASE_SSL_REQUIRE=False is usually appropriate.
# If you use DATABASE_PUBLIC_URL or another provider that requires SSL, set it to True.

SECRET_KEY="change-me-in-production"
DATABASE_PUBLIC_URL="postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_TCP_PROXY_DOMAIN}}:${{Postgres.RAILWAY_TCP_PROXY_PORT}}/${{Postgres.PGDATABASE}}"
DATABASE_URL="${{Postgres.DATABASE_URL}}"
ALLOW_RAILWAY_PRIVATE_DATABASE_URL=False
DATABASE_SSL_REQUIRE=False
DATABASE_CONNECT_TIMEOUT=10
PGDATA="/var/lib/postgresql/data/pgdata"
PGDATABASE="${{POSTGRES_DB}}"
PGHOST="${{RAILWAY_PRIVATE_DOMAIN}}"
PGPASSWORD="${{POSTGRES_PASSWORD}}"
PGPORT="5432"
PGUSER="${{POSTGRES_USER}}"
POSTGRES_DB="railway"
POSTGRES_PASSWORD="${{POSTGRES_PASSWORD}}"
POSTGRES_USER="postgres"
RAILWAY_DEPLOYMENT_DRAINING_SECONDS="60"
SSL_CERT_DAYS="820"

# Your Vercel production domain
CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-vercel-domain.vercel.app

# Optional preview-domain support for Vercel preview URLs
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
# CSRF_TRUSTED_ORIGINS=https://your-vercel-domain.vercel.app,https://*.vercel.app

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
